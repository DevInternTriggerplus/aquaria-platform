# Copy to .env and fill in. Never commit .env.

# --- Django ---------------------------------------------------------------- #
DJANGO_SETTINGS_MODULE=config.settings.dev
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-me-before-any-real-use
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- PostgreSQL ------------------------------------------------------------ #
# The platform targets PostgreSQL. Point this at your server.
DATABASE_URL=postgres://aquaria:aquaria@127.0.0.1:5432/aquaria

# Local-only escape hatch. When no PostgreSQL server is reachable, set this to
# 1 to run the suite against SQLite instead. Never enable it in staging or
# production: the schema relies on PostgreSQL behaviour for the capacity and
# money guarantees.
USE_SQLITE_FALLBACK=0

# --- Front ends ------------------------------------------------------------ #
# Origins allowed to call the API with credentials (Next dev server, Flutter web).
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# --- Signing --------------------------------------------------------------- #
# Signs QR ticket payloads. Rotating this invalidates issued QR codes.
TICKET_SIGNING_KEY=replace-me-before-any-real-use
